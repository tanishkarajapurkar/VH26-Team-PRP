{
  "name": "amazon-store-traffic-simulator",
  "version": "1.0.0",
  "description": "Realistic real-time traffic simulator for Website 1 (continuous idle background traffic and flash sale bursts)",
  "main": "src/simulator.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/simulator.ts",
    "continuous": "tsx src/simulator.ts --mode=continuous",
    "surge": "tsx src/simulator.ts --mode=surge --rps=300 --duration=30"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.12.12",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
